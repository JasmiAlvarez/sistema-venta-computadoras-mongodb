# .gitignore - Sistema para Venta de Computadoras

# Archivos de entorno y secretos
.env
.env.local
.env.*.local
*.env
secrets/
config/keys/
*.key
*.pem
*.crt

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Entornos virtuales Python
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# Archivos temporales y cachés
*.tmp
*.temp
*.cache
.cache/
.tmp/
.temp/
*.swp
*.swo
*~

# Archivos de compilación
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj

# Logs
logs/
*.log
log/

# Respaldos de bases de datos
*.sql.bak
*.bak
*.dump
*.backup
backup/
backups/

# Configuraciones locales de IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/
.project
.classpath
.settings/

# Archivos de sistema
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
